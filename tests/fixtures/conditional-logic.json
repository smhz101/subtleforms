        { "key": "s3", "type": "step", "children": [ { "key": "email", "type": "email" } ] }
      ] },
      "values": { "need_ship": "no" },
      "expected": { "hidden_fields": ["address", "row", "zip", "city"], "required_fields": [], "hidden_steps": ["s2"] }
