        { "key": "c", "type": "text", "logic": { "action": "show", "groups": [ { "rules": [ { "field": "b", "operator": "equals", "value": "go" } ] } ] } }
      ] },
      "values": { "a": "stop", "b": "go" },
      "expected": { "hidden_fields": ["b", "c"], "required_fields": [], "hidden_steps": [] }
