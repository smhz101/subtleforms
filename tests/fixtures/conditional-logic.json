    {
      "name": "step shown",
      "schema": { "fields": [
        { "key": "s1", "type": "step", "children": [ { "key": "need_ship", "type": "radio" } ] },
        { "id": "s2", "type": "step", "logic": { "action": "show", "groups": [ { "rules": [ { "field": "need_ship", "operator": "equals", "value": "yes" } ] } ] }, "children": [ { "key": "address", "type": "text" } ] }
      ] },
      "values": { "need_ship": "yes" },
      "expected": { "hidden_fields": [], "required_fields": [], "hidden_steps": [] }
    },
    {
      "name": "global logic rule hides target",
      "schema": {
        "fields": [ { "key": "a", "type": "text" }, { "key": "b", "type": "text" } ],
        "logic": [ { "if": { "field": "a", "operator": "equals", "value": "x" }, "then": { "action": "hide", "target": "b" } } ]
      },
      "values": { "a": "x" },
      "expected": { "hidden_fields": ["b"], "required_fields": [], "hidden_steps": [] }
    }
