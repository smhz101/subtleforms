   }
  }
 ],
 "actions": [
  {
   "id": 20,
   "type": "save",
   "label": "Store",
   "active": 1,
   "meta": {}
  },
  {
   "id": 21,
   "type": "email",
   "label": "Admin email",
   "active": 1,
   "meta": {
    "to": "{wp:admin_email}",
    "email_subject": "New message from {field:firstname}",
    "email_message": "{field:details}\n{fields_table}\nBy {field:email}",
    "from_name": "{wp:site_title}",
    "from_address": "{system:admin_email}",
    "reply_to": "{field:email}",
    "email_format": "html",
    "cc": "",
    "bcc": ""
   }
  },
  {
   "id": 22,
   "type": "email",
   "label": "Copy to visitor",
   "active": 1,
   "meta": {
    "to": "{field:email}",
    "email_subject": "Thanks",
    "email_message": "Hi {field:firstname}, {post:id}",
    "conditions": {
     "process": 1,
     "connector": "all",
     "when": [
      {
       "connector": "AND",
       "key": "subscribe",
       "comparator": "equal",
       "value": "1",
       "type": "field",
       "modelType": "when"
      }
     ]
    }
   }
  },
  {
   "id": 23,
   "type": "successmessage",
   "label": "Success",
   "active": 1,
   "meta": {
    "success_msg": "<p>Thank you {field:firstname}.</p>"
   }
  },
  {
   "id": 24,
   "type": "mailchimp",
   "label": "Newsletter",
   "active": 1,
   "meta": {}
  }
 ]
}