{
 "form": {
  "id": 7,
  "title": "Ninja contact"
 },
 "form_meta": [
  {
   "key": "sub_limit_number",
   "value": "100"
  },
  {
   "key": "sub_limit_msg",
   "value": "No more entries."
  }
 ],
 "fields": [
  {
   "id": 1,
   "type": "firstname",
   "label": "First name",
   "key": "firstname",
   "order": 1,
   "meta": {
    "label": "First name",
    "key": "firstname",
    "type": "firstname",
    "order": "1",
    "required": "1"
   }
  },
  {
   "id": 2,
   "type": "lastname",
   "label": "Last name",
   "key": "lastname",
   "order": 2,
   "meta": {
    "label": "Last name",
    "key": "lastname",
    "type": "lastname",
    "order": "2",
    "required": "1"
   }
  },
  {
   "id": 3,
   "type": "email",
   "label": "Email",
   "key": "email",
   "order": 3,
   "meta": {
    "label": "Email",
    "key": "email",
    "type": "email",
    "order": "3",
    "required": "1",
    "placeholder": "you@example.com",
    "desc_text": "Never shared."
   }
  },
  {
   "id": 4,
   "type": "listselect",
   "label": "Topic",
   "key": "topic",
   "order": 4,
   "meta": {
    "label": "Topic",
    "key": "topic",
    "type": "listselect",
    "order": "4",
    "options": [
     {
      "label": "Sales",
      "value": "sales",
      "selected": 0,
      "order": 0
     },
     {
      "label": "Support",
      "value": "support",
      "selected": 0,
      "order": 1
     }
    ],
    "required": "1",
    "conditions": [
     {
      "process": 1,
      "connector": "all",
      "when": [
       {
        "connector": "AND",
        "key": "topic",
        "comparator": "equal",
        "value": "support",
        "type": "field",
        "modelType": "when"
       }
      ],
      "then": [
       {
        "key": "details",
        "trigger": "show_field",
        "value": "",
        "type": "field",
        "modelType": "then"
       }
      ]
     }
    ]
   }
  },
  {
   "id": 5,
   "type": "textarea",
   "label": "Details",
   "key": "details",
   "order": 5,
   "meta": {
    "label": "Details",
    "key": "details",
    "type": "textarea",
    "order": "5",
    "input_limit": "300",
    "input_limit_type": "characters"
   }
  },
  {
   "id": 6,
   "type": "listcheckbox",
   "label": "Extras",
   "key": "extras",
   "order": 6,
   "meta": {
    "label": "Extras",
    "key": "extras",
    "type": "listcheckbox",
    "order": "6",
    "options": [
     {
      "label": "Gift wrap",
      "value": "gift wrap",
      "selected": 0,
      "order": 0
     },
     {
      "label": "Express",
      "value": "express",
      "selected": 0,
      "order": 1
     }
    ]
   }
  },
  {
   "id": 7,
   "type": "checkbox",
   "label": "Subscribe",
   "key": "subscribe",
   "order": 7,
   "meta": {
    "label": "Subscribe",
    "key": "subscribe",
    "type": "checkbox",
    "order": "7",
    "default_value": "unchecked"
   }
  },
  {
   "id": 8,
   "type": "date",
   "label": "Visit date",
   "key": "visit",
   "order": 8,
   "meta": {
    "label": "Visit date",
    "key": "visit",
    "type": "date",
    "order": "8",
    "date_format": "DD/MM/YYYY"
   }
  },
  {
   "id": 9,
   "type": "starrating",
