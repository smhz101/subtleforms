{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "subtleforms/form",
  "version": "2.7.2",
  "title": "SubtleForms",
  "category": "widgets",
  "description": "Embed a SubtleForms form",
  "icon": "feedback",
  "keywords": ["form", "contact", "subtleforms", "embed"],
  "textdomain": "subtleforms",
  "supports": {
    "align": true,
    "html": false,
    "customClassName": true
  },
  "attributes": {
    "formId": {
      "type": "number",
      "default": 0
    },
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "showDescription": {
      "type": "boolean",
      "default": true
    },
    "theme": {
      "type": "string",
      "default": "default"
    },
    "ajax": {
      "type": "boolean",
      "default": false
    },
    "tabIndex": {
      "type": "number",
      "default": 0
    },
    "fieldValues": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": {
      "formId": 0
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css"
}
