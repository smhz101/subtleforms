    "name": "minLength",
    "label": "Minimum characters",
    "min": 0,
    "section": "validation"
   },
   {
    "type": "text",
    "name": "pattern",
    "label": "Pattern (regular expression)",
    "placeholder": "^[A-Z]{2}[0-9]{4}$",
    "section": "validation"
   },
   {
    "type": "select",
    "name": "inputMask",
    "label": "Input mask",
    "help": "Formats the answer as the visitor types.",
    "options": [
     {
      "value": "",
      "label": "None"
     },
     {
      "value": "phone",
      "label": "Phone"
     },
     {
      "value": "date_dmy",
      "label": "Date DD/MM/YYYY"
     },
     {
      "value": "date_mdy",
      "label": "Date MM/DD/YYYY"
     },
     {
      "value": "date_ymd",
      "label": "Date YYYY-MM-DD"
     },
     {
      "value": "time_24",
      "label": "Time HH:MM (24-hour)"
     },
     {
      "value": "zip_us",
      "label": "Postcode or ZIP (US)"
     },
     {
      "value": "custom",
      "label": "Custom"
     }
    ],
    "section": "validation"
   },
   {
    "type": "text",
    "name": "maskPattern",
    "label": "Pattern",
    "help": "9 is a digit, A is a letter, * is a letter or digit. Anything else is typed for the visitor, for example AA-9999.",
    "placeholder": "AA-9999",
    "section": "validation",
    "showWhen": {
     "inputMask": [
      "custom"
     ]
    }
   },
   {
    "type": "mask_try",
    "name": "maskTry",
    "label": "Try it",
    "section": "validation",
    "showWhen": {
     "inputMask": [
      "phone",
      "date_dmy",
      "date_mdy",
      "date_ymd",
      "time_24",
      "zip_us",
      "custom"
     ]
    }
   },
   {
    "type": "select",
    "name": "maskStore",
    "label": "Save as",
    "help": "Digits only removes the dashes, spaces and brackets the mask adds before the answer is saved.",
    "options": [
     {
      "value": "typed",
      "label": "Save as typed"
     },
     {
      "value": "digits",
      "label": "Save digits only"
     }
    ],
    "section": "validation",
    "showWhen": {
     "inputMask": [
      "phone",
      "zip_us",
      "custom"
     ]
    }
   },
   {
    "type": "text",
    "name": "requiredMessage",
    "label": "Message when left empty",
    "placeholder": "This field is required.",
    "section": "validation"
   },
   {
    "type": "text",
    "name": "validationMessage",
    "label": "Custom validation message",
    "help": "Shown when the answer is not valid, for example a wrong email address, a number out of range or text that does not match the pattern. Leave empty for the standard message.",
    "section": "validation"
   },
   {
    "type": "text",
    "name": "adminLabel",
    "label": "Admin label",
    "help": "Used in entries, emails, exports and integrations instead of the public label.",
    "section": "advanced"
   },
   {
    "type": "checkbox",
    "name": "readOnly",
    "label": "Read-only",
    "help": "Visitors can see but not change the value.",
    "section": "advanced"
   },
   {
    "type": "text",
    "name": "cssClass",
    "label": "CSS class",
    "placeholder": "my-field",
    "section": "advanced"
   }
  ],
  "meta": {
   "category": "regular",
   "order": 0,
   "description": "Short answer on one line"
  },
  "layoutControls": [],
  "paletteHidden": false,
  "enabled": true
